{
	"$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
	"linter": {
		"rules": {
			"performance": {
				"noImgElement": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn",
				"noUnusedFunctionParameters": "warn"
			},
			"suspicious": {
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["info"]
					}
				}
			},
			"nursery": {
				"useSortedClasses": "warn"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "info"
			}
		}
	}
}
